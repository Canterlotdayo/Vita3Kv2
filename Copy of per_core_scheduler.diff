-    return -1;
+    // Only schedule threads with a single-core affinity.
+    // Multi-core masks (0x30000, 0x70000, etc.) and default (0) run freely.
+    switch (affinity_mask) {
+    case 0x10000: return 0;
+    case 0x20000: return 1;
+    case 0x40000: return 2;
+    default: return -1;
+    }
 }
 
