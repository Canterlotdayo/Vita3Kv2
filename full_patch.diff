+        LOG_ERROR("  CPU context:\n{}", ctx.description());
+    }
+    LOG_ERROR("============================");
+
+    // On a real Vita this calls the registered abort handler then terminates.
+    // Returning 0 allows the runtime to attempt recovery rather than hanging.
+    return 0;
 }
 
