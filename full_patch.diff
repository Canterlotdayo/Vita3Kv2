+
+    // Dump full thread context for crash diagnosis
+    const ThreadStatePtr thread = emuenv.kernel.get_thread(thread_id);
+    const char *tname = thread ? thread->name.c_str() : "unknown";
+    LOG_ERROR("=== ABORT HANDLER CALLED ===");
